{
  "expo": {
    "name": "Closy",
    "slug": "closy",
    "version": "1.0.0",
    "scheme": "closy",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FDFBF7",
    "android": {
      "package": "com.nhom.closy",
      "backgroundColor": "#FDFBF7"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "@react-native-google-signin/google-signin",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Closy cần máy ảnh để chụp trang phục của bạn.",
          "photosPermission": "Closy cần truy cập thư viện để bạn chọn ảnh trang phục."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Closy dùng vị trí để xem thời tiết."
        }
      ],
      "expo-splash-screen",
      "expo-sqlite",
      "expo-status-bar",
      "expo-web-browser"
    ],
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "0dd93884-ccc3-408c-8f6a-629c6289a1fb"
      }
    }
  }
}
